# ==============================================================================
# SOFTWARE ARCHITECTURE DRIFT DETECTOR - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and configure according to your deployment environment.
# Never commit real credentials or secret keys to version control.
# ==============================================================================

# --- Database Configuration ---
# SQLite default for local development:
DATABASE_URL=sqlite:///./backend/drift_detector.db
# PostgreSQL deployment example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/drift_detector

# --- Server & Network ---
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# --- Authentication & Session Security ---
# Set to 'true' in production HTTPS deployments to enforce Secure cookie flag
COOKIE_SECURE=false
SESSION_COOKIE_NAME=drift_session

# --- Brevo (Sendinblue) Transactional Email API ---
# If using Brevo API v3, provide your API key.
# Note: If Brevo security has "Authorised IPs" enabled, ensure your server IP is added
# at https://app.brevo.com/security/authorised_ips or disable the IP restriction.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@drift-detector.enterprise.com
BREVO_SENDER_NAME=Software Architecture Drift Detector

# --- Real Email Service (SMTP) Configuration ---
# Provide transactional SMTP credentials for production email delivery:
# Examples:
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, SMTP_PASSWORD=<16-char App Password>
#   Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USE_TLS=true, SMTP_PASSWORD=<Brevo SMTP Key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@drift-detector.enterprise.com
SMTP_FROM_NAME=Software Architecture Drift Detector
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Development Mailbox Mode:
# Set to 'true' for local development & automated testing (saves sent emails to data/mailbox/)
# Set to 'false' in production to strictly require active SMTP delivery
EMAIL_TEST_MODE=true

# --- Frontend Production API Configuration (Static Host / GitHub Pages) ---
# When hosting frontend on GitHub Pages, set VITE_API_URL to your deployed FastAPI backend URL.
# Can also be set as a GitHub Repository Variable (VITE_API_URL) for automatic workflow injection:
# VITE_API_URL=https://drift-detector-backend.onrender.com

# --- Optional AI Architectural Explanations ---
# Core detection engine is 100% deterministic and DOES NOT require external AI keys.
# If configured, AI provides plain-language architectural explanations for confirmed findings.
AI_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=
